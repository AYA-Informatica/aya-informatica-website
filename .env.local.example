# ── AYA Informatica — Environment Variables ──────────────────
# 1. Copy this file:  cp .env.local.example .env.local
# 2. Fill in real values
# 3. NEVER commit .env.local — it is in .gitignore
# ─────────────────────────────────────────────────────────────

# ── Site URL ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://ayainformatica.tech

# ── Email / SMTP (contact form) ──────────────────────────────
# Zero-cost option: use your existing Gmail with an App Password
#
# STEP 1: Enable 2FA on your Google account (required)
# STEP 2: Go to: myaccount.google.com/apppasswords
# STEP 3: Create an app password called "AYA Website"
# STEP 4: Paste it below as SMTP_PASS
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ay.company.andy@gmail.com
SMTP_PASS=your-gmail-app-password-here
SMTP_FROM="AYA Informatica" <ay.company.andy@gmail.com>
CONTACT_TO=ay.company.andy@gmail.com

# ── Alternative SMTP providers (uncomment one if not using Gmail) ──
# Outlook/Hotmail:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
#
# Zoho Mail (free, custom domain):
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
#
# Resend (3,000 emails/month free — great for scaling):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=your-resend-api-key

# ── Fallback SMTP (optional) ─────────────────────────────────
# Used automatically if the primary SMTP host fails to send.
# Leave unset to disable the fallback.
# SMTP_FALLBACK_HOST=smtp.resend.com
# SMTP_FALLBACK_PORT=587
# SMTP_FALLBACK_USER=resend
# SMTP_FALLBACK_PASS=your-resend-api-key

# ── Cloudflare Turnstile (optional captcha) ──────────────────
# BOTH keys must be set together, or neither.
#   - Setting only the secret would make the server demand a token the
#     browser has no widget to produce, rejecting every submission.
#   - Setting only the site key renders a widget that is never verified.
# The form and the API route both treat captcha as off unless both are present.
#
# Get a free key pair at: dash.cloudflare.com → Turnstile → Add site
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# ── Upstash Redis (rate limiting) ────────────────────────────
# Without these the rate limiter falls back to an in-memory store, which
# resets on every serverless cold start — effectively disabling it in
# production. Set both for durable rate limiting.
# Free tier: console.upstash.com → Create Database → REST API
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token
